# ── Redis ──────────────────────────────────────────────────────────────────────
REDIS_MAXMEMORY=256mb
REDIS_EVICTION_POLICY=allkeys-lru    # allkeys-lru | allkeys-lfu | noeviction

# ── TTL estático por tipo de query (segundos) ──────────────────────────────────
TTL_Q1=120
TTL_Q2=120
TTL_Q3=90
TTL_Q4=60
TTL_Q5=30

# ── Generador de Respuestas ────────────────────────────────────────────────────
# LATENCY_FACTOR_MS: ms de latencia simulada por cada 10k registros procesados.
# Con ~50k registros por zona:
#   0.5ms → miss tarda ~2.5ms  (backend "invisible", sin backlog observable)
#   5ms   → miss tarda ~25ms   (cuello de botella visible en E1/E2, default)
#   80ms  → miss tarda ~400ms  (backlog crece con 1 consumer, E3/E4/E5)
LATENCY_FACTOR_MS=5

# ── Generador de Tráfico ───────────────────────────────────────────────────────
TRAFFIC_DISTRIBUTION=zipf            # zipf | uniform
NUM_REQUESTS=2000
ARRIVAL_RATE=50                      # req/s
ZIPF_ALPHA=1.2

# Valores discretos de confidence_min para Q1/Q2/Q3
# Menos valores = más cache hits (mayor reutilización de claves)
# "0.0,0.7"         → 2 valores (hit rate alto,  realista)
# "0.0,0.5,0.7,0.9" → 4 valores (hit rate bajo,  más cardinalidad)
CONF_VALUES=0.0,0.7

# ── Kafka Consumer ─────────────────────────────────────────────────────────────
# MAX_RETRIES: reintentos antes de enviar a DLQ
# RETRY_DELAY_MS: base del backoff exponencial (ms)
# Backoff total con MAX_RETRIES=5, RETRY_DELAY_MS=200:
#   200 + 400 + 800 + 1600 + 3200 = 6200ms (6.2s)
# Para que recovery_rate > 0: falla debe durar > backoff parcial pero
# el backend debe volver antes de agotar TODOS los reintentos.
MAX_RETRIES=3
RETRY_DELAY_MS=500
